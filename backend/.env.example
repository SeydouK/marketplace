# =====================================================================
# Modele de configuration LOCALE. Copier en .env (jamais committe).
# En local : base PostgreSQL locale, stockage disque, email SMTP (Gmail).
# =====================================================================

# ── Securite ─────────────────────────────────────────────────────────
JWT_SECRET=marketplaceSecretKeyForJwtTokenGeneration2026VeryLongAndSecureKeyForHs512

# ── Base de donnees (optionnel en local : defauts localhost) ─────────
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketplace
# SPRING_DATASOURCE_USERNAME=marketplace
# SPRING_DATASOURCE_PASSWORD=marketplace

# ── Stockage des fichiers : local (disque) ───────────────────────────
STORAGE_PROVIDER=local

# ── Email : SMTP (Gmail) en local ────────────────────────────────────
MAIL_PROVIDER=smtp
MAIL_ENABLED=true
MAIL_USERNAME=adresse@gmail.com
MAIL_PASSWORD=mot-de-passe-application-gmail
MAIL_FROM=adresse@gmail.com
MAIL_FROM_NAME=BétailMarket

# ── Paiement GeniusPay ───────────────────────────────────────────────
# Clés sandbox depuis le dashboard GeniusPay. Ne jamais committer les vraies.
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_API_KEY=pk_sandbox_xxxxxxxx
GENIUSPAY_API_SECRET=sk_sandbox_xxxxxxxx
# Fourni lors de l'enregistrement du webhook (signature HMAC-SHA256).
GENIUSPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
# UUID du wallet marchand, source des versements vendeurs (payouts).
GENIUSPAY_WALLET_ID=

# ── Divers ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
