# =====================================================================
# Variables d'environnement de PRODUCTION (MODELE — placeholders).
# Copier en .env.prod (ignore par git) et y mettre les vraies valeurs,
# ou saisir directement ces variables dans le dashboard de l'hebergeur.
# NE JAMAIS mettre de vrai secret dans CE fichier (il est committe).
#
#   • Base de donnees : Neon (PostgreSQL)
#   • Stockage fichiers : Backblaze B2 (compatible S3)
#   • Email : Brevo (API HTTPS transactionnelle)
# =====================================================================

# Active le profil de production (charge application-prod.properties)
SPRING_PROFILES_ACTIVE=prod

# Render fournit automatiquement PORT ; ne pas le definir manuellement.

# ── Base de donnees Neon ─────────────────────────────────────────────
# Recuperer la chaine depuis Neon, la prefixer par "jdbc:" et NE GARDER
# que ?sslmode=require (retirer channel_binding, non gere par le driver JDBC).
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=__mot_de_passe_neon__

# ── Securite JWT (chaine aleatoire >= 64 caracteres) ─────────────────
# Generer p.ex. avec : openssl rand -hex 48
JWT_SECRET=__remplacer_par_un_secret_long_et_aleatoire__

# ── Stockage Backblaze B2 (provider actif) ───────────────────────────
STORAGE_PROVIDER=b2
# Endpoint S3 affiche dans la page du bucket B2 (champ "Endpoint").
# La region est le segment du milieu, p.ex. endpoint
#   https://s3.us-east-005.backblazeb2.com  ⟶  B2_REGION=us-east-005
# IMPORTANT : B2_ENDPOINT et B2_REGION doivent correspondre.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET=betailmarket
B2_ACCESS_KEY=__b2_keyID__
B2_SECRET_KEY=__b2_applicationKey__
B2_REGION=us-east-005

# ── Stockage Cloudflare R2 (inactif — pret pour plus tard) ───────────
# Pour basculer sur R2 : passer STORAGE_PROVIDER=r2 et remplir ces 5 lignes.
# Endpoint S3 du compte : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
#R2_BUCKET=betailmarket
#R2_ACCESS_KEY=__r2_access_key_id__
#R2_SECRET_KEY=__r2_secret_access_key__
#R2_REGION=auto

# ── Email Brevo ──────────────────────────────────────────────────────
MAIL_PROVIDER=brevo
MAIL_ENABLED=true
BREVO_API_KEY=xkeysib-__cle_api_brevo__
# Expediteur : doit etre un email/domaine verifie dans Brevo
MAIL_FROM=no-reply@betailmarket.ci
MAIL_FROM_NAME=BétailMarket

# ── URLs publiques (CORS + liens dans les emails) ────────────────────
# Front : domaine Netlify ; Back : domaine Render.
APP_FRONTEND_URL=https://betailmarket.netlify.app
APP_BACKEND_URL=https://betailmarket-api.onrender.com

# ── Divers ───────────────────────────────────────────────────────────
GEMINI_API_KEY=__cle_api_gemini__
