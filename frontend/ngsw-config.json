{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",

  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "cartographie",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/vendor/leaflet/**",
          "/assets/icons/**",
          "/assets/favicon.svg"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],

  "dataGroups": [
    {
      "name": "tuiles-carte",
      "urls": [
        "https://a.tile.openstreetmap.org/**",
        "https://b.tile.openstreetmap.org/**",
        "https://c.tile.openstreetmap.org/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 600,
        "maxAge": "14d",
        "timeout": "5s"
      }
    }
  ]
}
